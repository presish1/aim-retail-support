[
  {
    "id": "general_policy",
    "turns": [
      "Could you explain the return policy?"
    ],
    "expect": {
      "intent": "policy",
      "outcome": "GUIDE_ANSWER",
      "guide": "return_policy",
      "contains": "30",
      "stage": "contact"
    }
  },
  {
    "id": "refund_timing",
    "turns": [
      "How long do I need to wait for my refund?"
    ],
    "expect": {
      "intent": "policy",
      "guide": "refund_timing",
      "stage": "contact",
      "no_tickets": true
    }
  },
  {
    "id": "privacy_question",
    "turns": [
      "Why do you need my mobile number?"
    ],
    "expect": {
      "intent": "identity",
      "guide": "identity_reason",
      "stage": "contact"
    }
  },
  {
    "id": "tracking_only",
    "turns": [
      "Where is my order?",
      "aarav@example.com",
      "4812",
      "Please give me just the tracking number"
    ],
    "expect": {
      "intent": "order_status",
      "contains": "DEMO4812IN",
      "not_contains": "₹",
      "order": "4812"
    }
  },
  {
    "id": "arrival_followup",
    "turns": [
