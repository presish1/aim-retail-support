# Backend only. Add your own key to an ignored .env; never commit a real key.
THREADLINE_MODEL=gemini-3.8-flash
THREADLINE_MODEL_PROVIDER=gemini
THREADLINE_MODEL_URL=https://generativelanguage.googleapis.com/v1beta
THREADLINE_MODEL_API_KEY=
THREADLINE_MODEL_REGION=Google Gemini API — cloud processing
THREADLINE_SEMANTIC_RAG=true
THREADLINE_EMBEDDING_MODEL=gemini-embedding-001
# Gemini 3.8 uses provider sampling defaults and LOW thinking; temperature/top-p are omitted.
# Optional Ollama/compatible adapters retain THREADLINE_SUPPORT_TEMPERATURE / TOP_P.
# For an OpenAI-compatible hosted endpoint, set provider=compatible and URL ending in /v1.
# THREADLINE_MODEL_API_KEY=
# THREADLINE_MODEL_REGION=region-verified-by-operator
