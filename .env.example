# Optional. Defaults use local Ollama and synthetic data.
THREADLINE_MODEL=qwen3:8b
THREADLINE_MODEL_PROVIDER=ollama
THREADLINE_MODEL_URL=http://127.0.0.1:11434
# Low-variance support wording. Temperature affects sampling, not factual authority.
THREADLINE_SUPPORT_TEMPERATURE=0.2
THREADLINE_SUPPORT_TOP_P=0.8
# For an OpenAI-compatible hosted endpoint, set provider=compatible and URL ending in /v1.
# THREADLINE_MODEL_API_KEY=
# THREADLINE_MODEL_REGION=region-verified-by-operator
